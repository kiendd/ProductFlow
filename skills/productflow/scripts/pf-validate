#!/usr/bin/env python3
"""Check the docs and change trees against the ProductFlow format rules."""

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import _pflib as pf


def build_parser():
    parser = argparse.ArgumentParser(
        prog="pf-validate",
        description="Validate frontmatter, sections, requirements, deltas, tasks, links, and manifest freshness.",
    )
    parser.add_argument("--json", action="store_true", dest="as_json", help="emit findings as JSON")
    parser.add_argument("--path", default=None, help="only report findings under this repo-relative path")
    return parser


def run(argv):
    args = build_parser().parse_args(argv)
    root = pf.find_root(Path.cwd())
    config = pf.load_config(root)
    findings = pf.filter_findings(pf.validate(root, config), args.path)
    errors = [f for f in findings if f["level"] == "error"]

    if args.as_json:
        sys.stdout.write(
            json.dumps(
                {
                    "ok": not errors,
                    "errors": len(errors),
                    "warnings": len(findings) - len(errors),
                    "findings": findings,
                },
                ensure_ascii=False,
                indent=2,
            )
            + "\n"
        )
    else:
        for f in findings:
            sys.stdout.write(
                "%s:%s: %s [%s] %s\n" % (f["path"], f["line"] or 0, f["level"], f["code"], f["message"])
            )
        sys.stdout.write(
            "%d error(s), %d warning(s)\n" % (len(errors), len(findings) - len(errors))
        )
    return 1 if errors else 0


main = pf.main_wrapper(run)

if __name__ == "__main__":
    sys.exit(main())
