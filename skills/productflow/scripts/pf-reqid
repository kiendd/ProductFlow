#!/usr/bin/env python3
"""Allocate the next requirement IDs for a domain."""

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import _pflib as pf


def build_parser():
    parser = argparse.ArgumentParser(
        prog="pf-reqid",
        description="Print the next N unused requirement IDs for a domain, one per line.",
    )
    parser.add_argument("domain", help="domain name, e.g. billing or identity/user-auth")
    parser.add_argument("--count", type=int, default=1, help="how many IDs to allocate (default: 1)")
    return parser


def run(argv):
    args = build_parser().parse_args(argv)
    if args.count < 1:
        raise pf.PfError(2, "--count must be >= 1")
    root = pf.find_root(Path.cwd())
    config = pf.load_config(root)
    for req_id in pf.next_req_ids(root, config, args.domain, args.count):
        sys.stdout.write(req_id + "\n")
    return 0


main = pf.main_wrapper(run)

if __name__ == "__main__":
    sys.exit(main())
